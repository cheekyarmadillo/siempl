       {"title": "Successful RDP logon from an IP with recent failures", "rule_id": "scn_bf_success_after_failures", "severity": "high", "status": "new", "expected_triage": "true_positive", "injection_flagged": false},
       {"title": "Encoded PowerShell launched by WMI", "rule_id": "scn_bf_encoded_powershell", "severity": "critical", "status": "active", "expected_triage": "true_positive", "injection_flagged": false},
       {"title": "New account added to local administrators", "rule_id": "scn_bf_new_local_admin", "severity": "critical", "status": "new", "expected_triage": "true_positive", "injection_flagged": false}
     ]},
    {"name": "lateral_movement", "source_ids": ["scn-lateral-winsec", "scn-lateral-netflow", "scn-lateral-sysmon"],
